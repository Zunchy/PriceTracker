@page "/productslist/{searchTerm}"


<h1>Product Results for: @searchTerm</h1>

<table class="table">
    <thead>
        <tr>
            <th>Item Source</th>
            <th>Product Image</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Product Link</th>
        </tr>
    </thead>
    <tbody>
        @foreach (DisplayItem item in displayItemsMercari)
        {
            <tr>
                <td>Mercari</td>
                <td><img src="@item.ItemImage"></td>
                <td>@item.ItemName</td>
                <td>$@item.ItemPrice</td>
                <td><a target="_blank" rel="noopener noreferrer" href="@item.ItemLink">View this Item on Mercari</a></td>
                <td><button class="btn btn-primary" data-button="@item.ItemLink" @onclick="() => InitiateTrack(item.ItemLink)">Track This Item</button></td>
            </tr>
        }

        @foreach (DisplayItem item in displayItemsEbid)
        {
            <tr>
                <td>eBid</td>
                <td><img src="@item.ItemImage"></td>
                <td>@item.ItemName</td>
                <td>$@item.ItemPrice</td>
                <td><a target="_blank" rel="noopener noreferrer" href="@item.ItemLink">View this Item on ebid</a></td>
                <td><button class="btn btn-primary" data-button="@item.ItemLink" @onclick="() => InitiateTrack(item.ItemLink)">Track This Item</button></td>
            </tr>
        }

        @foreach (DisplayItem item in displayItemsPoshmark)
        {
            <tr>
                <td>Poshmark</td>
                <td><img src="@item.ItemImage"></td>
                <td>@item.ItemName</td>
                <td>$@item.ItemPrice</td>
                <td><a target="_blank" rel="noopener noreferrer" href="@item.ItemLink">View this Item on Poshmark</a></td>
                <td><button class="btn btn-primary" data-button="@item.ItemLink" @onclick="() => InitiateTrack(item.ItemLink)">Track This Item</button></td>
            </tr>
        }

        @foreach (DisplayItem item in displayItemsEcrater)
        {
            <tr>
                <td>eCrater</td>
                <td><img src="@item.ItemImage"></td>
                <td>@item.ItemName</td>
                <td>$@item.ItemPrice</td>
                <td><a target="_blank" rel="noopener noreferrer" href="@item.ItemLink">View this Item on eCrater</a></td>
                <td><button class="btn btn-primary" data-button="@item.ItemLink" @onclick="() => InitiateTrack(item.ItemLink)">Track This Item</button></td>
            </tr>
        }

    </tbody>
</table>


@code {

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    [Parameter]
    public String searchTerm { get; set; }

    DataFormater formater = new DataFormater();
    Scraper scraper = new Scraper();

    List<DisplayItem> displayItemsMercari = new List<DisplayItem>();
    List<DisplayItem> displayItemsEbid = new List<DisplayItem>();
    List<DisplayItem> displayItemsPoshmark = new List<DisplayItem>();
    List<DisplayItem> displayItemsEcrater = new List<DisplayItem>();

    String currentUser; // email address of user


    protected override async Task OnInitializedAsync()
    {

        // Gets current user, if no user is logged in, currentUser = null
        AuthenticationState authState = await AuthenticationStateTask;
        currentUser = authState.User.Identity.Name;

        Parallel.Invoke(() => displayItemsMercari = formater.FormatMercari(scraper.ScrapeMercari(searchTerm)),
        () => displayItemsEbid = formater.FormatEBid(scraper.ScrapeEBid(searchTerm)),
        () => displayItemsPoshmark = formater.FormatPoshmark(scraper.ScrapePoshmark(searchTerm)),
        () => displayItemsEcrater = formater.FormatEcrater(scraper.ScrapeEcrater(searchTerm)));

    }

    // Process of tracking an item user clicked on
    public void InitiateTrack(String link)
    {
        ItemTracker tracker = new ItemTracker();

        if (currentUser == null) // User is not logged in, redirect to login
        {

        }
        else
        {
            tracker.CreateTrackedItemRelation(currentUser, link);
        }
    }
}