@page "/productslist/{searchTerm}"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject EbayService ProductService
@inject TrackingService TrackingService

<h1>Product Results for: @searchTerm</h1>

<p>
    <Searchcomponent></Searchcomponent>
</p>

@*TODO fix persistent loading*@
<div class="spinner"></div>

@* Displays all of the products in card form *@
<div class="row">
    @foreach (DisplayItem item in displayAllItems)
    {
        <ProductCardComponent prodImgSrc = "@item.ItemImage"
                              prodName   = "@item.ItemName"
                              prodPrice  = "@item.ItemPrice.ToString()"
                              prodLink   = "@item.ItemLink"></ProductCardComponent>
    }
</div>


@code {

    [Parameter]
    public String searchTerm { get; set; }


    [Parameter]
    public bool ebayCheck { get; set; } = true;

    [Parameter]
    public bool ebidCheck { get; set; } = true;

    [Parameter]
    public bool ecraterCheck { get; set; } = true;

    [Parameter]
    public bool mercariCheck { get; set; } = true;

    [Parameter]
    public bool poshmarkCheck { get; set; } = true;

    DataFormater formater = new DataFormater();
    Scraper scraper = new Scraper();

    List<DisplayItem> displayItemsEbay = new List<DisplayItem>();
    List<DisplayItem> displayItemsMercari   = new List<DisplayItem>();
    //List<DisplayItem> displayItemsEbid      = new List<DisplayItem>();
    List<DisplayItem> displayItemsPoshmark  = new List<DisplayItem>();
    List<DisplayItem> displayItemsEcrater   = new List<DisplayItem>();
    List<DisplayItem> displayAllItems       = new List<DisplayItem>();


    protected override async Task OnInitializedAsync()
    {
        await Task.Run(ScrapeWebsites);
    }

    private void ScrapeWebsites()
    {
        displayItemsEbay = await ProductService.SearchProductAsync(searchTerm, 20);
      
        // Scrape the websites and Format the data
        Parallel.Invoke(
            () => displayItemsMercari   = formater.FormatMercari(scraper.ScrapeMercari(searchTerm)),
            //() => displayItemsEbid      = formater.FormatEBid(scraper.ScrapeEBid(searchTerm)),
            () => displayItemsPoshmark  = formater.FormatPoshmark(scraper.ScrapePoshmark(searchTerm)),
            () => displayItemsEcrater   = formater.FormatEcrater(scraper.ScrapeEcrater(searchTerm)));

        // Add all lists into one list
        displayAllItems.AddRange(displayItemsMercari);
        //displayAllItems.AddRange(displayItemsEbid);
        displayAllItems.AddRange(displayItemsPoshmark);
        displayAllItems.AddRange(displayItemsEcrater);
    }

    public async Task InitiateTrack(DisplayItem item)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userPrinciple = authState.User;

        if (userPrinciple.Identity.IsAuthenticated)
        {
            await TrackingService.TrackItem(userPrinciple, item.ItemName, item.ItemLink);
        }
    }
}