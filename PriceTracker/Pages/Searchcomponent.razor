<div class="container">
    <input type="text" @onkeyup=Enter @bind-value="searchTerm" />
    <button class="btn btn-primary" @onclick="GoToProductsComponent">
        Find Product
    </button>
    <ul class="ks-cboxtags">
        <li>
            <input type="checkbox" id="ebayCheckBox" @bind-value="ebayCheck" checked />
            <label for="ebayCheckBox">Ebay</label>
        </li>

        <li>
            <input type="checkbox" id="ebidCheckBox" @bind-value="ebidCheck" checked />
            <label for="ebidCheckBox">Ebid</label>
        </li>

        <li>
            <input type="checkbox" id="ecraterCheckBox" @bind-value="ecraterCheck" checked />
            <label for="ecraterCheckBox">eCrater</label>
        </li>

        <li>
            <input type="checkbox" id="mercariCheckBox" @bind-value="mercariCheck" checked />
            <label for="mercariCheckBox">Mercari</label>
        </li>

        <li>
            <input type="checkbox" id="poshmarkCheckBox" @bind-value="poshmarkCheck" checked />
            <label for="poshmarkCheckBox">Poshmark</label>
        </li>
    </ul>
</div>

    @*<br />
    Ebay: @ebayCheck

    <br />
    eBid: @ebidCheck

    <br />
    Mercari: @mercariCheck

    <br />
    Poshmark: @poshmarkCheck*@
</p>

@code {
    private string searchTerm;

    private void GoToProductsComponent()
    {
        GetSelected();
        NavigationManager.NavigateTo($"productslist/{searchTerm}", true); // true refreshes the page
                                                                          //InvokeAsync(() => { StateHasChanged(); });
    }

    private void Enter()
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
            GoToProductsComponent();
    }

    private bool ebayCheck = true;
    private bool ebidCheck = true;
    private bool ecraterCheck = true;
    private bool mercariCheck = true;
    private bool poshmarkCheck = true;

    List<bool> isSelected { get; set; } = new List<bool> { };
    private void GetSelected()
    {
        isSelected.Add(ebayCheck);
        isSelected.Add(ebidCheck);
        isSelected.Add(ecraterCheck);
        isSelected.Add(mercariCheck);
        isSelected.Add(poshmarkCheck);
    }
}
