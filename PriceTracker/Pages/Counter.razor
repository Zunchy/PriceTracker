            () => displayItemsPoshmark = formater.FormatPoshmark(scraper.ScrapePoshmark("coin")),
            () => displayItemsEcrater = formater.FormatEcrater(scraper.ScrapeEcrater("card")),
            () => checkLists(displayItemsMercari, displayItemsEbid, displayItemsPoshmark, displayItemsEcrater));


