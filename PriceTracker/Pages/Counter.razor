@page "/counter"

<h1>Search</h1>

<button class="btn btn-primary" @onclick="IncrementCount">Search</button>


@foreach (DisplayItem item in displayItems)
{

    <p>Name: @item.ItemName</p>
    <p>Price: @item.ItemPrice</p>
    <a href="@item.ItemLink"><p>Link: @item.ItemLink</p></a>
    <br>

}


@code {

    String mercariData = "";
    String eBidData = "";
    List<DisplayItem> displayItems = new List<DisplayItem>();
    DataFormater formater = new DataFormater();

    private void IncrementCount()
    {
        Scraper scraper = new Scraper();

        //mercariData = scraper.ScrapeMercari();
        //displayItems = formater.FormatMercari(mercariData);
        eBidData = scraper.ScrapeEBid();
        displayItems = formater.FormatEBid(eBidData);
    }
}
