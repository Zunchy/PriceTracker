@page "/"
@*@inject NavigationManager NavigationManager*@
@inject TrackingService TrackingService
@inject EbayService EbayService


<div class="container">
    @*<div>*@
    <h1>Search for a product</h1>
    <Searchcomponent></Searchcomponent>
</div>

<button @onclick="(e => TestTracker())">Test</button>


@code {

    private void TestTracker()
    {
        //TrackingService.UpdateTrackedItemPrices();

        Scraper scraper = new Scraper();
        IQueryable<ApplicationUser> users = TrackingService.GetAllUsers();

        foreach (ApplicationUser user in users)
        {
            List<UserProduct> userProductList = TrackingService.GetUserProductsByUserId(user.Id);

            foreach (UserProduct product in userProductList)
            {
                Product currentProduct = TrackingService.GetProductById(product.ProductId);

                switch (currentProduct.Source)
                {
                    case "Ebay":
                        break;
                    case "Mercari":
                        scraper.ScrapePriceByMercariItem(currentProduct.ProductIdentifier);
                        break;
                    case "eBid":
                        scraper.ScrapePriceByEbidItem(currentProduct.ProductIdentifier);
                        break;
                    case "Poshmark":
                        scraper.ScrapePriceByPoshmarkItem(currentProduct.ProductIdentifier);
                        break;
                    case "eCrater":
                        scraper.ScrapePriceByEcraterItem(currentProduct.ProductIdentifier);
                        break;
                }
            }
        }

    }

}