@page "/"
@inject NavigationManager NavigationManager

<head>
    <title>Price Tracker - Home</title>
</head>


<h1>Search for a product</h1>
<input type="text" @onkeyup=Enter @bind-value="searchTerm" />
<button class="btn btn-primary" @onclick="GoToProductsComponent">
    Find Product
</button>
