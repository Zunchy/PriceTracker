@code {

    public async Task InitiateTrack(DisplayItem item)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userPrinciple = authState.User;

        if (userPrinciple.Identity.IsAuthenticated)
        {
            await TrackingService.TrackItem(userPrinciple, item);

            await JsRuntime.InvokeAsync<object>("alert", "Tracking Successful, view your newly tracked product in the my products page.");
        }
    }

}